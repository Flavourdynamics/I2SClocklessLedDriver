{
  "name": "I2SClocklessLedDriver",
  "keywords": "NeoPixel, WS2811, WS2812, WS2813, SK6812, 74HC595, shift-register, PARLIO, RGB, RGBW",
  "description": "ESP32 Arduino library for driving parallel WS281x/SK6812 LEDs, including an ESP32-P4 PARLIO shift-register driver.",
  "homepage": "https://github.com/hpwit/I2SClocklessLedDriver",
  "repository":
  {
    "type": "git",
    "url": "https://github.com/hpwit/I2SClocklessLedDriver"
  },
  "version": "1.0.0",
  "frameworks": "arduino",
  "platforms": "*",
  "build": {
        "srcFilter": [
            "+<*>",
            "-<examples/>"
        ]
    },
  "export": {
    "include": [
      "src",
      "examples",
      "library.json",
      "library.properties",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      ".DS_Store",
      "src/.DS_Store",
      "examples/.DS_Store",
      "examples/*/.DS_Store"
    ]
  },
  "headers": [
    "I2SClocklessLedDriver.h",
    "ShiftRegisterClocklessLedDriver.h"
  ]
}

